### ─── Auth Module ────────────────────────────────────────────
# Full auth flow. All responses are chained — no copy-pasting.
#
# WORKFLOW: Run requests top-to-bottom.
# The token from Login is automatically used in /me, /refresh, and /logout.

@BASE_URL = http://localhost:8000

###
# @name Register
# POST /api/auth/register
# Run once to create your account. Skip if already registered.
#
# 201 → { id, email, name, role, storageQuota, usedStorage, createdAt }
# 409 → Email already registered
POST {{BASE_URL}}/api/auth/register
Content-Type: application/json

{
  "email": "shrikant@infocusp.com",
  "password": "supersecret123",
  "name": "Shrikant Jha"
}

###
# @name Login
# POST /api/auth/login
# Run this first — all requests below auto-use this token.
#
# 200 → { accessToken, refreshToken, tokenType, expiresIn }
POST {{BASE_URL}}/api/auth/login
Content-Type: application/json

{
  "email": "shrikant@infocusp.com",
  "password": "supersecret123"
}

###
# Token is extracted automatically from the Login response above.
@TOKEN = {{Login.response.body.$.accessToken}}
@REFRESH_TOKEN = {{Login.response.body.$.refreshToken}}

###
# @name GetMyProfile
# GET /api/auth/me
# Uses the token from the Login response above — no paste needed.
#
# 200 → { id, email, name, role, storageQuota, usedStorage, createdAt }
# 401 → Token missing or invalid
GET {{BASE_URL}}/api/auth/me
Authorization: Bearer {{TOKEN}}
Accept: application/json

###
# @name Refresh
# POST /api/auth/refresh
# Rotates the refresh token from Login for a brand-new access/refresh pair.
# The old refresh token becomes invalid — reusing it revokes every active
# session for this user (theft/reuse detection).
#
# 200 → { accessToken, refreshToken, tokenType, expiresIn }
# 401 → Refresh token unknown, expired, or already used
POST {{BASE_URL}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{REFRESH_TOKEN}}"
}

###
# @name Logout
# POST /api/auth/logout
# Revokes a refresh token, ending that session. Requires a valid access token.
#
# 204 → Refresh token revoked
# 401 → Refresh token invalid, or does not belong to the authenticated user
POST {{BASE_URL}}/api/auth/logout
Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "refreshToken": "{{Refresh.response.body.$.refreshToken}}"
}
