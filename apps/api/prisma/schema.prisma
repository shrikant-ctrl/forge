datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

enum Role {
  USER
  ADMIN
}

enum ShareAccess {
  VIEWER
  EDITOR
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  name         String
  passwordHash String      @map("password_hash")
  role         Role        @default(USER)
  storageQuota BigInt      @default(10737418240) @map("storage_quota") // 10 GB default
  usedStorage  BigInt      @default(0) @map("used_storage")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  folders       Folder[]
  files         File[]
  shareLinks    ShareLink[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Folder {
  id        String    @id @default(uuid())
  name      String
  parentId  String?   @map("parent_id")
  parent    Folder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]  @relation("FolderHierarchy")

  ownerId   String    @map("owner_id")
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  files     File[]
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([parentId])
  @@map("folders")
}

model File {
  id          String        @id @default(uuid())
  name        String
  sizeBytes   BigInt        @map("size_bytes")
  mimeType    String        @map("mime_type")
  storageKey  String        @unique @map("storage_key")

  folderId    String?       @map("folder_id")
  folder      Folder?       @relation(fields: [folderId], references: [id], onDelete: Cascade)

  ownerId     String        @map("owner_id")
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  versions    FileVersion[]
  shareLinks  ShareLink[]

  isDeleted   Boolean       @default(false) @map("is_deleted")
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([folderId])
  @@map("files")
}

model FileVersion {
  id            String   @id @default(uuid())
  fileId        String   @map("file_id")
  file          File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  versionNumber Int      @map("version_number")
  storageKey    String   @map("storage_key")
  sizeBytes     BigInt   @map("size_bytes")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([fileId, versionNumber])
  @@map("file_versions")
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique @map("token_hash")
  userId              String    @map("user_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedByTokenHash String?   @map("replaced_by_token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model ShareLink {
  id          String      @id @default(uuid())
  token       String      @unique @default(uuid())
  fileId      String      @map("file_id")
  file        File        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdById String      @map("created_by_id")
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  access      ShareAccess @default(VIEWER)
  expiresAt   DateTime?   @map("expires_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([token])
  @@map("share_links")
}
